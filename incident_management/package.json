{
  "name": "incident_management",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[hybrid]": {
          "kind": "mocked",
          "users": {
            "Admin": {
              "id": "admin",
              "name": "Administrator",
              "password": "admin",
              "roles": [
                "admin"
              ]
            },
            "User": {
              "id": "user",
              "name": "User",
              "password": "user",
              "roles": [
                "user"
              ]
            }
          }
        }
      }
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "watch-user_management_app": "cds watch --open usermanagement.usermanagementapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-incident_status_app": "cds watch --open incidentstatus.incidentstatusapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "sapux": [
    "app/user_management_app",
    "app/incident_status_app"
  ]
}
